<!-- captantan fork: strings of the certificate prompts (captantan/CertificatePrompt.java), of the
     Back question in a session window (captantan/SessionWindow.java), of the "RDP options"
     screen of the bookmark editor (captantan/ConnectionOptions*.java) and of the session
     notifications (captantan/SessionNotifications.java, SessionKeeper.java). -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <string name="captantan_cert_title_new">Check the server certificate</string>
    <string name="captantan_cert_title_changed">Server certificate changed</string>
    <string name="captantan_cert_msg_new">The certificate of %1$s has not been trusted before. Compare its fingerprint with the server\'s before you trust it.</string>
    <string name="captantan_cert_msg_changed">Warning: the certificate of %1$s is not the one you trusted before. If the server\'s certificate was not replaced or renewed, someone may be intercepting this connection: cancel.</string>
    <string name="captantan_cert_mismatch">The certificate is issued to \"%1$s\", not to the name or address you connect to. This is normal for a self-signed certificate reached by IP address or by another name.</string>
    <string name="captantan_cert_mismatch_no_name">The certificate does not name the host or address you connect to. This is normal for a self-signed certificate reached by IP address or by another name.</string>
    <string name="captantan_cert_redirect">The server redirected this connection here.</string>
    <string name="captantan_cert_gateway">This is the certificate of the RD Gateway.</string>
    <string name="captantan_cert_heading_old">Trusted before</string>
    <string name="captantan_cert_heading_new">Presented now</string>
    <string name="captantan_cert_subject">Subject</string>
    <string name="captantan_cert_issuer">Issuer</string>
    <string name="captantan_cert_fingerprint">SHA-256 fingerprint</string>
    <string name="captantan_cert_pem">Certificate</string>
    <string name="captantan_cert_none">(none)</string>
    <string name="captantan_cert_trust">Trust</string>
    <string name="captantan_cert_trust_new">Trust new</string>
    <string name="captantan_cert_once">Only this time</string>
    <!-- Back in a session window (roadmap 2.1, captantan/SessionWindow.java) -->
    <string name="captantan_back_message">Leave this session running and go to the connection list, or disconnect it?</string>
    <string name="captantan_back_leave">Leave running</string>
    <string name="captantan_back_disconnect">Disconnect</string>
    <string name="captantan_back_capture_note">This session redirects the microphone or the camera. That stays on while the session runs, also when no window shows it.</string>
    <!-- A session that no visible window shows ended by itself (captantan/SessionKeeper.java) -->
    <string name="captantan_session_ended">%1$s: the session has ended</string>
    <!-- Sessions in the background (roadmap 2.3, captantan/SessionNotifications.java) -->
    <string name="captantan_channel_sessions">Running sessions</string>
    <string name="captantan_channel_sessions_desc">Shown while a session is live, also with no window open. Lists the sessions and ends them.</string>
    <string name="captantan_channel_events">Session alerts</string>
    <string name="captantan_channel_events_desc">A session in the background needs an answer, or has ended.</string>
    <plurals name="captantan_sessions_running">
        <item quantity="one">%d session running</item>
        <item quantity="other">%d sessions running</item>
    </plurals>
    <string name="captantan_state_connecting">Connecting</string>
    <string name="captantan_state_connected">Connected</string>
    <string name="captantan_state_waiting">Waiting for your answer</string>
    <string name="captantan_session_line">%1$s: %2$s</string>
    <string name="captantan_capture_this">Microphone or camera redirected to this session</string>
    <string name="captantan_capture_list">Microphone or camera redirected: %1$s</string>
    <string name="captantan_action_disconnect">Disconnect</string>
    <string name="captantan_action_disconnect_one">Disconnect %1$s</string>
    <string name="captantan_action_disconnect_all">Disconnect all</string>
    <string name="captantan_waiting_title">%1$s needs an answer</string>
    <string name="captantan_waiting_text">Open the session to answer.</string>
    <string name="captantan_waiting_text_timeout">Open the session to answer. Without an answer the connection is cancelled in %1$d minutes.</string>
    <string name="captantan_waiting_toast">%1$s needs an answer: open it from the connection list</string>
    <string name="captantan_ended_failed">The connection failed or the server ended the session.</string>
    <string name="captantan_ended_disconnected">The session was disconnected.</string>
    <string name="captantan_notification_permission_why">Allow notifications to see the sessions that run in the background and end them from there.</string>
    <!-- RDP options (roadmap 1.4) -->
    <string name="captantan_options_title">RDP options</string>
    <string name="captantan_options_summary">Graphics mode and other settings of this app</string>
    <string name="captantan_options_cat_graphics">Graphics</string>
    <string name="captantan_graphics_mode">Graphics mode</string>
    <string name="captantan_graphics_mode_unavailable">This build has no H.264 decoder</string>
    <string name="captantan_graphics_mode_note">Applies when GFX and H264 are both on under Performance; with either off, this setting is not used. Best lets the server choose AVC444 (sharpest colour), AVC420 or a non-H.264 codec. Step down to AVC420 or No H.264 if the picture breaks up or stays black.</string>
    <string-array name="captantan_graphics_mode_entries">
        <item>Best (AVC444, AVC420, RemoteFX)</item>
        <item>AVC420 (no AVC444)</item>
        <item>No H.264 (RemoteFX, progressive)</item>
    </string-array>
    <!-- Stored names of captantan/GraphicsMode, in the same order. Never change them. -->
    <string-array name="captantan_graphics_mode_values" translatable="false">
        <item>best</item>
        <item>avc420</item>
        <item>no_h264</item>
    </string-array>
</resources>
