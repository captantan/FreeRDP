    <string name="captantan_session_ended">%1$s: the session has ended</string>
    <!-- Sessions in the background (roadmap 2.3, captantan/SessionNotifications.java) -->
    <string name="captantan_channel_sessions">Running sessions</string>
    <string name="captantan_channel_sessions_desc">Shown while a session is live, also with no window open. Lists the sessions and ends them.</string>
    <string name="captantan_channel_events">Session alerts</string>
    <string name="captantan_channel_events_desc">A session in the background needs an answer, or has ended.</string>
    <plurals name="captantan_notification_sessions_running">
        <item quantity="one">%d session running</item>
        <item quantity="other">%d sessions running</item>
    </plurals>
    <!-- also captantan_state_connecting, _connected and _ending of the switcher (below) -->
