<!-- captantan fork: the session bar's settings dialog (roadmap 4.1, captantan/SessionBar): mode,
     "keep in full screen" (4.2), edge and opacity of this connection, applied while it is open
     and saved when it closes; the remote scale (4.2, here since 5.2) and system-key capture
     (5.2), saved and applied at once. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="16dp"
        android:paddingRight="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/captantan_bar_mode"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/captantan_bar_settings_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/captantan_bar_mode_overlay"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/captantan_bar_mode_overlay" />

            <Button
                android:id="@+id/captantan_bar_mode_docked"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/captantan_bar_mode_docked" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- roadmap 4.2: docked only (SessionBar shows it for docked) -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/captantan_bar_settings_fullscreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/captantan_bar_fullscreen_keep"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <!-- the edge is overlay's (SessionBar shows these two for overlay only): docked is always
             at the top -->
        <TextView
            android:id="@+id/captantan_bar_settings_edge_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/captantan_bar_edge"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/captantan_bar_settings_edge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/captantan_bar_edge_top"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/captantan_bar_edge_top" />

            <Button
                android:id="@+id/captantan_bar_edge_bottom"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/captantan_bar_edge_bottom" />

            <Button
                android:id="@+id/captantan_bar_edge_left"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/captantan_bar_edge_left" />

            <Button
                android:id="@+id/captantan_bar_edge_right"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/captantan_bar_edge_right" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/captantan_bar_opacity"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <com.google.android.material.slider.Slider
            android:id="@+id/captantan_bar_settings_opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/captantan_bar_opacity"
            android:stepSize="5"
            android:valueFrom="30"
            android:valueTo="100" />

        <!-- roadmap 4.2's remote scale menu, here since 5.2 (captantan/RemoteScaleSwitch fills
             the chips; a link's scale is its own: then only the note shows) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/captantan_bar_scale"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/captantan_bar_settings_scale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <TextView
            android:id="@+id/captantan_bar_settings_scale_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/captantan_bar_scale_link"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <!-- roadmap 5.2: system-key capture (captantan/KeyCaptureController), saved at once -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/captantan_bar_settings_capture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/captantan_key_capture"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:id="@+id/captantan_bar_settings_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceBodySmall" />
    </LinearLayout>
</ScrollView>
