<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- captantan fork: the session bar's settings dialog (roadmap 4.1, captantan/SessionBar): mode,
     edge and opacity of this connection, applied while it is open and saved when it closes. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="16dp"
        android:paddingRight="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/captantan_bar_mode"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/captantan_bar_settings_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/captantan_bar_mode_overlay"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/captantan_bar_mode_overlay" />

            <Button
                android:id="@+id/captantan_bar_mode_hidden"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/captantan_bar_mode_hidden" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- captantan fork: the bar sits at the top only for now (4.1 device run); the edge
             choice is kept, not shown -->
        <TextView
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/captantan_bar_edge"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:visibility="gone"
            android:id="@+id/captantan_bar_settings_edge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/captantan_bar_edge_top"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/captantan_bar_edge_top" />

            <Button
                android:id="@+id/captantan_bar_edge_bottom"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/captantan_bar_edge_bottom" />

            <Button
                android:id="@+id/captantan_bar_edge_left"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/captantan_bar_edge_left" />

            <Button
                android:id="@+id/captantan_bar_edge_right"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/captantan_bar_edge_right" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/captantan_bar_opacity"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <com.google.android.material.slider.Slider
            android:id="@+id/captantan_bar_settings_opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/captantan_bar_opacity"
            android:stepSize="5"
            android:valueFrom="30"
            android:valueTo="100" />

        <TextView
            android:id="@+id/captantan_bar_settings_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceBodySmall" />
    </LinearLayout>
</ScrollView>
