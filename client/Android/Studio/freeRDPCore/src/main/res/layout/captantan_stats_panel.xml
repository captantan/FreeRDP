<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- captantan fork: the connection statistics panel (roadmap 7.1, captantan/StatsPanel): a card
     over the session view's top end corner. StatsPanel adds one row per figure to
     captantan_stats_rows and places and sizes the card. Nothing in it takes keyboard focus. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="?attr/materialCardViewElevatedStyle"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="false"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
    app:shapeAppearance="?attr/shapeAppearanceCornerLarge">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/captantan_stats_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <Button
                android:id="@+id/captantan_stats_close"
                style="?attr/materialIconButtonStyle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="8dp"
                android:focusable="false"
                android:contentDescription="@string/captantan_stats_close"
                app:icon="@drawable/captantan_ic_close"
                app:iconSize="20dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/captantan_stats_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <TableLayout
            android:id="@+id/captantan_stats_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:shrinkColumns="1"
            android:stretchColumns="1" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
