<!-- captantan fork (roadmap 1.4): the "RDP options" screen (captantan/ConnectionOptionsFragment).
     Each preference's key is a field of captantan/ConnectionPrefs; values are kept by the editor's
     ConnectionOptions.Draft and saved with the bookmark, not in SharedPreferences of their own. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="@string/captantan_options_cat_graphics">
        <ListPreference
            android:key="graphics_mode"
            android:title="@string/captantan_graphics_mode"
            android:entries="@array/captantan_graphics_mode_entries"
            android:entryValues="@array/captantan_graphics_mode_values"
            android:defaultValue="best"
            app:useSimpleSummaryProvider="true" />
        <Preference
            android:selectable="false"
            android:persistent="false"
            android:summary="@string/captantan_graphics_mode_note" />
    </PreferenceCategory>

    <!-- captantan fork (roadmap 3.3): captantan/RemoteScale -->
    <PreferenceCategory
        android:title="@string/captantan_options_cat_display">
        <ListPreference
            android:key="remote_scale"
            android:title="@string/captantan_remote_scale"
            android:entries="@array/captantan_remote_scale_entries"
            android:entryValues="@array/captantan_remote_scale_values"
            android:defaultValue="auto"
            app:useSimpleSummaryProvider="true" />
        <SeekBarPreference
            android:key="remote_scale_custom"
            android:title="@string/captantan_remote_scale_custom"
            android:defaultValue="150"
            app:min="100"
            android:max="500"
            app:seekBarIncrement="5"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />
        <Preference
            android:selectable="false"
            android:persistent="false"
            android:summary="@string/captantan_remote_scale_note" />
    </PreferenceCategory>

    <!-- captantan fork (roadmap 4.1): captantan/SessionBar -->
    <PreferenceCategory
        android:title="@string/captantan_options_cat_bar">
        <ListPreference
            android:key="bar_mode"
            android:title="@string/captantan_bar_mode"
            android:entries="@array/captantan_bar_mode_entries"
            android:entryValues="@array/captantan_bar_mode_values"
            android:defaultValue="docked"
            app:useSimpleSummaryProvider="true" />
        <!-- roadmap 4.2: docked only (ConnectionOptionsFragment enables it for docked) -->
        <SwitchPreferenceCompat
            android:key="bar_in_fullscreen"
            android:title="@string/captantan_bar_fullscreen_keep"
            android:summary="@string/captantan_bar_fullscreen_keep_summary"
            android:defaultValue="false" />
        <!-- the edge is overlay's: docked is always at the top (4.1 device run) -->
        <ListPreference
            android:key="bar_edge"
            android:title="@string/captantan_bar_edge_overlay"
            android:entries="@array/captantan_bar_edge_entries"
            android:entryValues="@array/captantan_bar_edge_values"
            android:defaultValue="top"
            app:useSimpleSummaryProvider="true" />
        <SeekBarPreference
            android:key="bar_opacity"
            android:title="@string/captantan_bar_opacity_percent"
            android:defaultValue="85"
            app:min="30"
            android:max="100"
            app:seekBarIncrement="5"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />
        <Preference
            android:selectable="false"
            android:persistent="false"
            android:summary="@string/captantan_bar_note" />
    </PreferenceCategory>

    <!-- captantan fork (roadmap 4.3): captantan/TouchMode, captantan/TrackpadInput -->
    <PreferenceCategory
        android:title="@string/captantan_options_cat_touch">
        <ListPreference
            android:key="touch_mode"
            android:title="@string/captantan_touch_mode"
            android:entries="@array/captantan_touch_mode_entries"
            android:entryValues="@array/captantan_touch_mode_values"
            android:defaultValue="direct"
            app:useSimpleSummaryProvider="true" />
        <SeekBarPreference
            android:key="pointer_speed"
            android:title="@string/captantan_pointer_speed"
            android:defaultValue="100"
            app:min="25"
            android:max="300"
            app:seekBarIncrement="5"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />
        <ListPreference
            android:key="touch_scroll"
            android:title="@string/captantan_touch_scroll"
            android:entries="@array/captantan_touch_scroll_entries"
            android:entryValues="@array/captantan_touch_scroll_values"
            android:defaultValue="natural"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:key="touch_drag"
            android:title="@string/captantan_touch_drag"
            android:entries="@array/captantan_touch_drag_entries"
            android:entryValues="@array/captantan_touch_drag_values"
            android:defaultValue="scroll"
            app:useSimpleSummaryProvider="true" />
        <!-- captantan fork (pen input): captantan/PenInput -->
        <ListPreference
            android:key="pen_mode"
            android:title="@string/captantan_pen_mode"
            android:entries="@array/captantan_pen_mode_entries"
            android:entryValues="@array/captantan_pen_mode_values"
            android:defaultValue="pen"
            app:useSimpleSummaryProvider="true" />
        <Preference
            android:selectable="false"
            android:persistent="false"
            android:summary="@string/captantan_touch_note" />
    </PreferenceCategory>

    <!-- captantan fork (roadmap 5.2): captantan/KeyCaptureController -->
    <PreferenceCategory
        android:title="@string/captantan_options_cat_keyboard">
        <SwitchPreferenceCompat
            android:key="key_capture"
            android:title="@string/captantan_key_capture"
            android:summary="@string/captantan_key_capture_summary"
            android:defaultValue="true" />
    </PreferenceCategory>

</PreferenceScreen>
